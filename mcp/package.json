{
  "name": "dio-bob-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server do Projeto Final DIO IBM Bob — expõe trilhas, desafios e certificados via HTTP/SSO/API",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "dio-bob-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --watch build/index.js",
    "start": "node build/index.js",
    "start:stdio": "node build/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "dio",
    "ibm-bob",
    "trilhas",
    "desafios",
    "certificados",
    "ia"
  ],
  "license": "MIT"
}
